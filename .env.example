# Client-local runtime configuration. No secrets belong in this section.
APP_NAME=Kioskina
APP_THEME_COLOR=#28634e
APP_BACKGROUND_COLOR=#f7f8f7
CLIENT_SYNC_API_URL=http://localhost:3001
CLIENT_LOCAL_DATABASE_NAME=kioskina-spike
CLIENT_TENANT_ID=
CLIENT_BRANCH_ID=
CLIENT_DEVICE_ID=
CLIENT_ACTOR_ID=
CLIENT_CURRENCY=ARS
CLIENT_LOCALE=es-AR
CLIENT_SYNC_BATCH_SIZE=100
CLIENT_LOCAL_SCAN_PAGE_SIZE=250

# Vite development server configuration.
VITE_CLIENT_PORT=5173
VITE_CLIENT_PREVIEW_PORT=4173
VITE_CLIENT_HOST=127.0.0.1

# Sync gateway configuration. Credentials belong only in a local, ignored .env file.
SYNC_API_HOST=127.0.0.1
SYNC_API_PORT=3001
SYNC_ALLOWED_ORIGINS=http://localhost:5173
COUCHDB_URL=http://127.0.0.1:5984
COUCHDB_DATABASE=kioskina-spike
COUCHDB_USERNAME=
COUCHDB_PASSWORD=
COUCHDB_HOST_PORT=5984
COUCHDB_IMAGE=couchdb:3.5.2@sha256:b80216f643e99d31df318c740dbc556ac08b56444030ed1d5e6d7b0d4e625213
SYNC_CLIENT_CREDENTIALS_JSON=
SYNC_MAX_EVENTS_PER_BATCH=250
SYNC_MAX_REQUEST_BYTES=2097152
SYNC_EXPORT_PAGE_SIZE=250
